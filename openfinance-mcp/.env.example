# ============================================================
# Copie este arquivo para .env e preencha. NUNCA commite o .env.
# ============================================================

# --- Credenciais da Pluggy (Fase 0) ---
# Obtidas em https://dashboard.pluggy.ai -> sua Application -> Development
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# --- Conexões bancárias (Fase 0) ---
# itemIds separados por vírgula. Um itemId = uma conexão com um banco.
# Ex.: 3f0a1b2c-...,9d8e7f6a-...
PLUGGY_ITEM_IDS=

# --- Servidor MCP ---
# Token que protege a URL do servidor. Gere com: openssl rand -hex 32
MCP_PATH_TOKEN=
PORT=3000

# --- Armazenamento local ---
DB_PATH=./data/finance.db

# --- Sincronização automática (fuso America/Sao_Paulo) ---
SYNC_CRON=0 7 * * *
TZ=America/Sao_Paulo
