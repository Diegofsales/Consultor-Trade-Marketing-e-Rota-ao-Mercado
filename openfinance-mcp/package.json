{
  "name": "openfinance-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor MCP read-only de Open Finance (Brasil) para ChatGPT e Hermes",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsx src/scripts/check.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "wipe": "node -e \"require('fs').rmSync(process.env.DB_PATH||'./data/finance.db',{force:true});console.log('Banco local apagado.')\""
  },
  "dependencies": {
    "pluggy-sdk": "0.90.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
